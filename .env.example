# Local development environment.
# Copy this file to `.env` at the repository root. Never commit `.env`.
# Every value below is a local/test placeholder, not a production credential.

NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
# Keep NEXT_PUBLIC_API_ORIGIN in sync with API_ORIGIN.
NEXT_PUBLIC_API_ORIGIN=http://localhost:3001

# MongoDB.
# Option A (default): local MongoDB from docker-compose.yml.
MONGODB_URI=mongodb://127.0.0.1:27017/real_time_chat_dev
# Option B: your own free Atlas M0 development cluster. Replace the placeholders.
# MONGODB_URI=mongodb+srv://<dev-user>:<dev-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=real_time_chat_dev
MONGODB_CONNECT_TIMEOUT_MS=5000

# Better Auth (implemented in P1-06). Generate a local-only secret with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=local-dev-only-change-me-32-characters-minimum
# Better Auth JWKS endpoint on the app origin (empty fails closed).
JWKS_URI=

# AI: the mock provider is the default and makes no network request.
# No provider key is required for local development.
AI_PROVIDER=mock
AI_MODEL=mock
AI_API_KEY=
AI_CONSENT_REQUIRED=true

# ICE / WebRTC traversal.
# The prototype is STUN-only. The default points at the local coturn service
# from docker-compose.yml, which also serves STUN; replace it with
# `stun:stun.cloudflare.com:3478` for a network STUN endpoint.
STUN_URLS=stun:localhost:3478
#
# TURN is optional and deferred for the prototype. To add TURN later, set all
# four TURN_* values and restart the API; buildIceServers() includes them with
# no code change. Per-call short-lived credentials remain P3-04.
# TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# TURN_USERNAME=dev
# TURN_CREDENTIAL=dev-only-not-a-secret
# TURN_REALM=chat.local
# TURN_CREDENTIAL_TTL_SECONDS=7200
